{
  "name": "BME280 Environmental Sensor",
  "author": "Codex",
  "pins": [ "VCC", "GND", "SCL", "SDA" ],
  "controls": [
    {
      "id": "temperature",
      "label": "Temperature",
      "type": "range",
      "min": -10,
      "max": 45,
      "step": 0.5,
      "default": 25,
      "unit": "°C"
    },
    {
      "id": "humidity",
      "label": "Humidity",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%"
    },
    {
      "id": "pressure",
      "label": "Pressure",
      "type": "range",
      "min": 950,
      "max": 1050,
      "step": 1,
      "default": 1013,
      "unit": "hPa"
    }
  ]
}
